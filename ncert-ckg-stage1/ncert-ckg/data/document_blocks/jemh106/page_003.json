    "bbox": [
      47.99,
      326.13,
      420.06,
      377.99
    ],
    "reading_order": 10,
    "text": "What can you say about the two photographs of the same size of the same\nperson one at the age of 10 years and the other at the age of 40 years? Are these\nphotographs similar? These photographs are of the same size but certainly they are\nnot of the same shape. So, they are not similar.",
    "latex": null,
    "image_ref": null,
    "confidence": 1.0
  },
