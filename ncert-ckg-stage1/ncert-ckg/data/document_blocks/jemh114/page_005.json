    "text": "(ii) What is the probability of getting a number less than 7 in a single throw of a die?",
    "latex": null,
    "image_ref": null,
    "confidence": 1.0
  },
  {
    "document_id": "NCERT_X_MATH_JEMH114",
    "page": 5,
