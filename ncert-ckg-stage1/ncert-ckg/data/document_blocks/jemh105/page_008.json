      405.09,
      419.82,
      466.07
    ],
    "reading_order": 13,
    "text": "= ` (8000 + 500 + 500 + 500)\n= ` (8000 + 3 × 500)\n= ` [8000 + (4 – 1) × 500]\n(for the 4th year)\n= ` 9500",
    "latex": null,
    "image_ref": null,
    "confidence": 1.0
