    "reading_order": 13,
    "text": "Solution : To calculate the median height, we need to find the class intervals and their\ncorresponding frequencies.",
    "latex": null,
    "image_ref": null,
    "confidence": 1.0
  },
  {
    "document_id": "NCERT_X_MATH_JEMH113",
    "page": 24,
    "block_id": "jemh113_p024_b14",
    "type": "paragraph",
